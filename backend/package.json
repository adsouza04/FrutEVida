{
  "name": "frut-e-vida-backend",
  "version": "2.0.0",
  "description": "API REST do app Frut & Vida (PI IV)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cors": "2.8.5",
    "express": "5.2.1"
  },
  "devDependencies": {
    "jest": "30.0.5",
    "supertest": "7.1.4"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "unrs-resolver@1.12.2": true
  }
}
